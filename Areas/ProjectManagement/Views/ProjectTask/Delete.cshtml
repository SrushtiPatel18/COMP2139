@model COMP2139_Lab02.Areas.ProjectManagement.Models.ProjectTask

@{
    ViewBag.Title = "Delete Project";
    Layout = "_Layout";
}

<h2>@ViewBag.Title</h2>

<h3>Are you sure you want to delete this project?</h3>
<div>
    <h4>ProjectTask Details...</h4>
    <hr/>

    <dl>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model =>model.Title)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Title)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Description)
        </dt>

        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Description)
        </dd>
        <dd class="col-sm-10">
            @Html.DisplayFor(model=>model.ProjectId)
        </dd>

        <dd class="col-sm-10">
            @Html.DisplayFor(model=>model.ProjectTaskId)
        </dd>

    </dl>

    <form asp-action="Delete" method="post">
        @Html.HiddenFor(model=>model.ProjectTaskId)
        <input type="submit" value="Delete" class="btn btn-danger">
        <a asp-acton="Index" class ="btn btn-secondary">Back to List</a>

    </form>
</div>