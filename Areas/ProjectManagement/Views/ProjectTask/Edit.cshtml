@model COMP2139_Lab02.Areas.ProjectManagement.Models.ProjectTask

@{
    ViewData["Title"] = "Edit project"; // sets the title of the view of  "Create Project"
}

<h2>Edit Project</h2>

<form asp-action="Edit" method="post">

    <!-- very important line 12
    Hidden field to ensure the ProjectId (primary key) is included in the form submission link
    in the data to the correct record in the database
    -->
    @Html.HiddenFor(model => model.ProjectId)
    <div class="form-group">
        <label asp-for="Title" class="control-label"></label>
        <input asp-for="Title" class="form-control"/>
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label asp-for="Description" class="control-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <!-- Include other form fields here -->

    <div class="form-group">
        <input type="submit" value="Save" class="btn btn-primary"/>
        <a asp-action="Index" btn="btn btn-seconndary">Cancel</a>
    </div>

</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}